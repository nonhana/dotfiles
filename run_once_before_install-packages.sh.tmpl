{{ if env "TERMUX_VERSION" }}#!/data/data/com.termux/files/usr/bin/bash
{{ else }}#!/usr/bin/env bash
{{ end -}}
# ============================================================
# chezmoi run_once_before — 按平台安装 CLI 工具链
# ============================================================
set -eu

echo "🔧 Installing CLI toolchain for {{ .chezmoi.os }}..."

{{ if eq .chezmoi.os "darwin" -}}
# ========== macOS: Homebrew ==========
if ! command -v brew >/dev/null 2>&1; then
    echo "❌ Homebrew not found. Install it first: https://brew.sh"
    exit 1
fi
echo "📦 Installing via Homebrew..."
brew install ripgrep fd bat eza zoxide fish starship git-delta dust fzf \
    procs choose-rust sd rip2 hyperfine ast-grep gping tealdeer just shfmt
brew install lazygit helix neovim tmux btop
brew install httpie pandoc
brew install node go python rust
brew install chezmoi git-lfs
echo "✅ macOS packages installed."
{{ end -}}

{{ if and (eq .chezmoi.os "linux") (not (env "TERMUX_VERSION")) -}}
# ========== 通用 Linux: apt（自动检测 root，无需/需 sudo）==========
echo "📦 Installing via apt..."
if [ "$(id -u)" -eq 0 ]; then SUDO=""; else SUDO="sudo"; fi
$SUDO apt update
# apt 里有的包（不含 nodejs：VPS 走 nvm）
$SUDO apt install -y \
    ripgrep fd-find bat eza zoxide fish starship \
    git-delta fzf lazygit helix neovim tmux \
    btop httpie tealdeer just hyperfine \
    shfmt pandoc \
    golang python3 rustc cargo
if command -v fdfind >/dev/null 2>&1 && ! command -v fd >/dev/null 2>&1; then
    $SUDO ln -sf "$(command -v fdfind)" /usr/local/bin/fd
fi

# apt 里没有的 CLI 工具 → cargo install
# 注意包名/二进制名差异：du-dust→dust, ast-grep→sg, 其余同名
if command -v cargo >/dev/null 2>&1; then
    for tool in du-dust sd ast-grep gping procs choose rip2; do
        case "$tool" in
            du-dust)  bin="dust" ;;
            ast-grep) bin="sg" ;;
            *)        bin="$tool" ;;
        esac
        if ! command -v "$bin" >/dev/null 2>&1; then
            echo "🦀 cargo install $tool..."
            cargo install "$tool"
        fi
    done
fi
echo "✅ Linux packages installed."
{{ end -}}

{{ if env "TERMUX_VERSION" -}}
# ========== Termux (Android) ==========
echo "📦 Installing via pkg..."
pkg update && pkg upgrade -y

# 启用 root-repo（btop 需要）
pkg install -y root-repo

# 核心工具链
pkg install -y \
    ripgrep fd bat eza zoxide fish starship git-delta dust fzf \
    lazygit helix neovim tmux \
    tealdeer just sd hyperfine \
    shfmt pandoc gping \
    nodejs golang python python-pip rust binutils

# root-repo 包
pkg install -y btop tsu termux-api

# httpie: 不走 pkg，走 pip
if ! command -v http >/dev/null 2>&1; then
    echo "🐍 pip install httpie..."
    pip install httpie
fi

# cargo 小众工具
for tool in procs choose rip2 ast-grep; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "🦀 cargo install $tool..."
        cargo install "$tool"
    fi
done

# 设 fish 为默认 shell
if command -v fish >/dev/null 2>&1; then
    CURRENT_SHELL="$(basename "$SHELL")"
    if [ "$CURRENT_SHELL" != "fish" ]; then
        echo "🐟 Setting fish as default shell..."
        chsh -s "$(command -v fish)"
    fi
fi
echo "✅ Termux packages installed."
{{ end -}}

echo "🎉 All packages installed for {{ .chezmoi.os }}."