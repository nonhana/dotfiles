{{ if env "TERMUX_VERSION" }}#!/data/data/com.termux/files/usr/bin/bash
{{ else }}#!/usr/bin/env bash
{{ end -}}
# ============================================================
# chezmoi run_once_before — 按平台安装 CLI 工具链
# ============================================================
set -eu

echo "🔧 Installing CLI toolchain for {{ .chezmoi.os }}..."

{{ if eq .chezmoi.os "darwin" -}}
# ========== macOS: Homebrew ==========
if ! command -v brew >/dev/null 2>&1; then
    echo "❌ Homebrew not found. Install it first: https://brew.sh"
    exit 1
fi
echo "📦 Installing via Homebrew..."
brew install ripgrep fd bat eza zoxide fish starship git-delta dust fzf \
    procs choose-rust sd rip2 hyperfine ast-grep gping tealdeer just shfmt
brew install lazygit helix neovim tmux btop
brew install httpie pandoc
brew install node go python rust
brew install chezmoi git-lfs
echo "✅ macOS packages installed."
{{ end -}}

{{ if and (eq .chezmoi.os "linux") (not (env "TERMUX_VERSION")) -}}
# ========== 通用 Linux: apt + GitHub release ==========
# 自动检测 root：root 免 sudo，普通用户自动带 sudo
if [ "$(id -u)" -eq 0 ]; then SUDO=""; else SUDO="sudo"; fi
echo "📦 Installing via apt..."
$SUDO apt update
# apt 里有的包（不含 nodejs：VPS 走 nvm；不含 starship/lazygit/helix，单独从 GitHub 装）
$SUDO apt install -y \
    ripgrep fd-find bat eza zoxide fish \
    git-delta fzf neovim tmux \
    btop httpie tealdeer just hyperfine \
    shfmt pandoc \
    golang python3 rustc cargo
if command -v fdfind >/dev/null 2>&1 && ! command -v fd >/dev/null 2>&1; then
    $SUDO ln -sf "$(command -v fdfind)" /usr/local/bin/fd
fi

# apt 里没有的 CLI 工具 → cargo install
# 注意包名/二进制名差异：du-dust→dust, ast-grep→sg, 其余同名
# 先确保现代 Rust：noble apt 的 cargo 是 1.75(太旧), 装不了 edition2024 (Rust≥1.85) 的包
echo "🦀 检查 Rust 工具链版本..."
if command -v cargo >/dev/null 2>&1; then
    CARGO_VER="$(cargo --version | awk '{print $2}')"   # 如 1.75.0
    CARGO_MINOR="$(echo "$CARGO_VER" | cut -d. -f2)"    # 如 75
    if [ -n "$CARGO_MINOR" ] && [ "$CARGO_MINOR" -lt 85 ] 2>/dev/null; then
        echo "⚠️ 系统 cargo $CARGO_VER 过旧(<1.85), 改用 rustup 装现代 stable Rust"
        if ! command -v rustup >/dev/null 2>&1; then
            curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
        fi
        # rustup 默认装到 ~/.cargo, 这个 /root 下; 加入 PATH
        export PATH="$HOME/.cargo/bin:$PATH"
    fi
fi

if command -v cargo >/dev/null 2>&1; then
    for tool in du-dust sd ast-grep gping procs choose rip2; do
        case "$tool" in
            du-dust)  bin="dust" ;;
            ast-grep) bin="sg" ;;
            *)        bin="$tool" ;;
        esac
        if ! command -v "$bin" >/dev/null 2>&1; then
            echo "🦀 cargo install $tool..."
            cargo install "$tool"
        fi
    done
fi

# ---- starship / lazygit / helix：noble apt 没有，从 GitHub latest release 动态下载 ----
# 按架构匹配资源名（.chezmoi.arch: amd64 | arm64）
{{ if eq .chezmoi.arch "amd64" -}}
    HELIX_ARCH="x86_64-linux"
    LAZYGIT_ARCH="linux_x86_64"
    STARSHIP_ARCH="x86_64-unknown-linux-gnu"
{{ else if eq .chezmoi.arch "arm64" -}}
    HELIX_ARCH="aarch64-linux"
    LAZYGIT_ARCH="linux_arm64"
    STARSHIP_ARCH="aarch64-unknown-linux-gnu"
{{ else -}}
    # 未识别架构：尝试用 cargo 装（Starship 有 cargo 版，helix/lazygit 需编译）
    HELIX_ARCH=""
{{ end -}}

# 从 GitHub API 取最新 release 的匹配资源 URL
gh_latest_url() { # $1=repo  $2=资源匹配正则 → 输出 URL
    curl -fsSL "https://api.github.com/repos/$1/releases/latest" \
        | grep browser_download_url | grep -E "$2" | head -1 \
        | sed -E 's/.*"(https[^"]+)".*/\1/'
}

install_gh_bin() { # $1=repo  $2=资源名  $3=二进制名  $4=解压后是否带顶层目录名
    repo="$1"; name="$2"; binname="$3"; toplevel="$4"
    if command -v "$binname" >/dev/null 2>&1; then
        echo "✅ $binname 已存在，跳过"
        return 0
    fi
    url="$(gh_latest_url "$repo" "$name")"
    if [ -z "$url" ]; then
        echo "⚠️ 未能找到 $repo/$name 的发布资源，跳过 $binname"
        return 0
    fi
    echo "⬇️ $binname ← $url"
    tmp="$(mktemp -d)"
    curl -fsSL -o "$tmp/pkg" "$url"
    case "$url" in
        *.tar.xz) tar -xJf "$tmp/pkg" -C "$tmp" ;;
        *.tar.gz|*.tgz) tar -xzf "$tmp/pkg" -C "$tmp" ;;
    esac
    found_bin="$(find "$tmp" -type f -name "$binname" -print -quit)"
    if [ -z "$found_bin" ]; then
        echo "⚠️ $binname 解压后未找到二进制，跳过"
        rm -rf "$tmp"; return 0
    fi
    install -m 0755 "$found_bin" /usr/local/bin/"$binname"
    # helix 需要 runtime 目录（Docs: 拷贝到 ~/.config/helix/runtime）
    if [ "$binname" = "hx" ]; then
        runtime_dir="$(find "$tmp" -maxdepth 2 -type d -name runtime -print -quit)"
        if [ -n "$runtime_dir" ]; then
            mkdir -p /usr/local/share/helix
            cp -r "$runtime_dir" /usr/local/share/helix/runtime
        fi
    fi
    rm -rf "$tmp"
    echo "✅ $binname 安装完成"
}

install_gh_bin "helix-editor/helix" "${HELIX_ARCH:-}" "hx" "1"
install_gh_bin "jesseduffield/lazygit" "${LAZYGIT_ARCH:-}" "lazygit" "1"
install_gh_bin "starship/starship" "${STARSHIP_ARCH:-}" "starship" "1"

echo "✅ Linux packages installed."
{{ end -}}

{{ if env "TERMUX_VERSION" -}}
# ========== Termux (Android) ==========
echo "📦 Installing via pkg..."
pkg update && pkg upgrade -y

# 启用 root-repo（btop 需要）
pkg install -y root-repo

# 核心工具链
pkg install -y \
    ripgrep fd bat eza zoxide fish starship git-delta dust fzf \
    lazygit helix neovim tmux \
    tealdeer just sd hyperfine \
    shfmt pandoc gping \
    nodejs golang python python-pip rust binutils

# root-repo 包
pkg install -y btop tsu termux-api

# httpie: 不走 pkg，走 pip
if ! command -v http >/dev/null 2>&1; then
    echo "🐍 pip install httpie..."
    pip install httpie
fi

# cargo 小众工具
for tool in procs choose rip2 ast-grep; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "🦀 cargo install $tool..."
        cargo install "$tool"
    fi
done

# 设 fish 为默认 shell
if command -v fish >/dev/null 2>&1; then
    CURRENT_SHELL="$(basename "$SHELL")"
    if [ "$CURRENT_SHELL" != "fish" ]; then
        echo "🐟 Setting fish as default shell..."
        chsh -s "$(command -v fish)"
    fi
fi
echo "✅ Termux packages installed."
{{ end -}}

echo "🎉 All packages installed for {{ .chezmoi.os }}."