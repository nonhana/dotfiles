[user]
	name = Xiang Zhou
	email = xiang.zhou@rightcapital.com
[core]
	ignorecase = false
[diff "lockb"]
	textconv = bun
	binary = true
[alias]
	mybr = !git branch -r | grep -v -e \"->\" | xargs -L1 git --no-pager show -s --oneline --author=\"$(git config user.name)\"
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[core]
	pager = delta
	excludesfile = {{ .chezmoi.homeDir }}/.gitignore_global
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	light = false
	line-numbers = true
	side-by-side = true
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
[pull]
	rebase = true
